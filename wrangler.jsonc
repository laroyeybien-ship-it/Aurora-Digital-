{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "aurora-digital",
  "main": "./worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/callback"
    ],
    "exclude": [
      "worker.js",
      "wrangler.jsonc"
    ]
  }
}
